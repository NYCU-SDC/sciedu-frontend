{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://sciedu.sdc.nycu.club/schemas/genetics-manifest-v2.json",
    "title": "SciEdu Genetics Course Manual Manifest",
    "type": "object",
    "required": ["version", "course", "authoring", "units"],
    "properties": {
        "version": { "const": 2 },
        "course": {
            "type": "object",
            "required": ["id", "title", "unitOrder"],
            "properties": {
                "id": { "const": "genetics" },
                "title": { "type": "string", "minLength": 1 },
                "unitOrder": {
                    "type": "array",
                    "items": { "type": "string" },
                    "minItems": 12,
                    "maxItems": 12
                }
            },
            "additionalProperties": false
        },
        "authoring": {
            "type": "object",
            "required": ["mode"],
            "properties": { "mode": { "const": "manual" } },
            "additionalProperties": false
        },
        "units": {
            "type": "array",
            "minItems": 12,
            "maxItems": 12,
            "items": {
                "type": "object",
                "required": ["id", "title", "category", "order", "pages"],
                "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "title": { "type": "string", "minLength": 1 },
                    "category": { "type": "string", "minLength": 1 },
                    "order": { "type": "integer", "minimum": 0 },
                    "pages": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 3,
                        "items": { "$ref": "#/$defs/page" }
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "approval": {
            "type": "object",
            "required": ["reviewer", "reviewedAt", "approvalHash"],
            "properties": {
                "reviewer": { "type": "string", "minLength": 1 },
                "reviewedAt": { "type": "string", "format": "date-time" },
                "approvalHash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                }
            },
            "additionalProperties": false
        },
        "image": {
            "type": "object",
            "required": ["fileName", "sha256", "width", "height"],
            "properties": {
                "fileName": { "type": "string", "pattern": "^[^/]+\\.jpg$" },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "width": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 10000
                },
                "height": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 10000
                }
            },
            "additionalProperties": false
        },
        "page": {
            "type": "object",
            "required": [
                "id",
                "type",
                "secondaryTitle",
                "activeNavbarTitles",
                "approvals"
            ],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "type": { "enum": ["material", "questions", "overview"] },
                "secondaryTitle": { "type": "string", "minLength": 1 },
                "activeNavbarTitles": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 0, "maximum": 2 }
                },
                "approvals": {
                    "type": "object",
                    "properties": {
                        "content": { "$ref": "#/$defs/approval" },
                        "frontend": { "$ref": "#/$defs/approval" }
                    },
                    "additionalProperties": false
                },
                "imageKey": { "type": "string", "minLength": 1 },
                "image": { "$ref": "#/$defs/image" },
                "description": { "type": "object" },
                "questionSections": { "type": "array" },
                "columns": { "type": "array" },
                "headers": { "type": "array" },
                "rows": { "type": "array" }
            },
            "additionalProperties": false
        }
    }
}
